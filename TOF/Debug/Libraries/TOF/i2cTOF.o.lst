1681:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** {
1682:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****   channel->TBCTR |= event;
1683:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** }
1684:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
