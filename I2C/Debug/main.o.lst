 103:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** #define PORT_IOCR_PC_Msk PORT0_IOCR0_PC0_Msk
 104:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** 
 105:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** #define PORT_IOCR_PC_Size 				(8U)
