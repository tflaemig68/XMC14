 123:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
 124:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @addtogroup XMClib XMC Peripheral Library
 125:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @{
 126:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
 127:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
 128:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
 129:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @addtogroup USIC
 130:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @brief Universal Serial Interface Channel(USIC) driver for serial communication.
 131:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
 132:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * The Universal Serial Interface Channel(USIC) module is a flexible interface module
 133:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * covering several serial communication protocols. A USIC module contains two
 134:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * independent communication channels named USICx_CH0 and USICx_CH1, with x
 135:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * being the number of the USIC module. The user can program, during run-time, which protocol will 
 136:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * by each communication channel and which pins are used.
 137:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * The driver provides APIs, configuration structures and enumerations to configure common features
 138:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * communication protocols.
 139:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
 140:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * USIC driver features:
 141:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Allows configuration of FIFO for transmit and receive functions.
 142:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Provides a structure type XMC_USIC_CH_t to represent the USIC channel registers in a programm
 143:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  friendly format.
 144:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Allows configuration of automatic update for frame length, word length, slave select or slave
 145:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Allows transmission of data to FIFO using XMC_USIC_CH_TXFIFO_PutData() and XMC_USIC_CH_TXFIFO
 146:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Allows reading of received data in FIFO using XMC_USIC_CH_RXFIFO_GetData()
 147:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Allows configuration of baudrate using XMC_USIC_CH_SetBaudrate()
 148:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * -# Provides API to trigger interrupts using XMC_USIC_CH_TriggerServiceRequest()
 149:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @{
 150:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
 151:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
 152:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /*******************************************************************************
 153:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * MACROS
 154:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *******************************************************************************/
 155:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
 156:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #define XMC_USIC0 ((XMC_USIC_t *)USIC0_BASE)			/**< USIC0 module base address */
 157:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #define XMC_USIC0_CH0 ((XMC_USIC_CH_t *)USIC0_CH0_BASE)	/**< USIC0 channel 0 base address */
 158:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #define XMC_USIC0_CH1 ((XMC_USIC_CH_t *)USIC0_CH1_BASE)	/**< USIC0 channel 1 base address */
 159:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
 160:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #if defined(USIC1)
 161:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #define XMC_USIC1 ((XMC_USIC_t *)USIC1_BASE)			/**< USIC1 module base address */
 162:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #define XMC_USIC1_CH0 ((XMC_USIC_CH_t *)USIC1_CH0_BASE)	/**< USIC1 channel 0 base address */
 163:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #define XMC_USIC1_CH1 ((XMC_USIC_CH_t *)USIC1_CH1_BASE)	/**< USIC1 channel 1 base address */
 164:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #endif
 165:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
 166:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** #if defined(USIC2)
