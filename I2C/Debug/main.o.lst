  69:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** /**
  70:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * @addtogroup GPIO
  71:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * @brief General Purpose Input Output (GPIO) driver for the XMC microcontroller family.
  72:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  73:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * GPIO driver provide a generic and very flexible software interface for all standard digital I/O 
  74:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Each port slice has individual interfaces for the operation as General Purpose I/O and it furthe
  75:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * connectivity to the on-chip periphery and the control for the pad characteristics.
  76:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  77:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * The driver is divided into Input and Output mode.
  78:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  79:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Input mode features:
  80:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Configuration structure XMC_GPIO_CONFIG_t and initialization function XMC_GPIO_Init()
  81:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Allows the selection of weak pull-up or pull-down device. Configuration structure XMC_GPIO_MO
  82:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC1
  83:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Allows the selection of input hysteresis. XMC_GPIO_SetInputHysteresis()
  84:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \endif
  85:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  86:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  87:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Output mode features:
  88:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Allows the selection of push pull/open drain and Alternate output. Configuration structure XM
  89:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC4
  90:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Allows the selection of pad driver strength. Configuration structure XMC_GPIO_OUTPUT_STRENGTH
  91:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \endif
  92:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  93:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Allows the selection of initial output level. Configuration structure XMC_GPIO_OUTPUT_LEVEL_t
  94:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  95:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *@{
  96:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  */
