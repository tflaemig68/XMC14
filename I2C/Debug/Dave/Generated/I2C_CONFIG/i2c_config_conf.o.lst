 105:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_i2c.h **** /**
 106:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_i2c.h ****  * @addtogroup XMClib XMC Peripheral Library
 107:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_i2c.h ****  * @{
 108:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_i2c.h ****  */
