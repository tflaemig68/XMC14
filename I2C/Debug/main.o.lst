 120:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** /**
 121:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Defines output level of a pin. Use type \a XMC_GPIO_OUTPUT_LEVEL_t for this enum.
 122:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  */
 123:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** typedef enum XMC_GPIO_OUTPUT_LEVEL
 124:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** {
 125:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****   XMC_GPIO_OUTPUT_LEVEL_LOW  = 0x10000U, /**<  Reset bit */
 126:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****   XMC_GPIO_OUTPUT_LEVEL_HIGH = 0x1U, 	/**< Set bit  */
 127:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** } XMC_GPIO_OUTPUT_LEVEL_t;
 128:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** 
 129:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** /**
 130:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Defines direct hardware control characteristics of the pin . Use type \a XMC_GPIO_HWCTRL_t for t
 131:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  */
 132:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** typedef enum XMC_GPIO_HWCTRL
 133:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** {
 134:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****   XMC_GPIO_HWCTRL_DISABLED     = 0x0U, /**<  Software control only */
 135:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****   XMC_GPIO_HWCTRL_PERIPHERAL1  = 0x1U, /**<  HWI0/HWO0 control path can override the software confi
 136:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****   XMC_GPIO_HWCTRL_PERIPHERAL2  = 0x2U  /**<  HWI1/HWO1 control path can override the software confi
 137:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** } XMC_GPIO_HWCTRL_t;
 138:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** 
