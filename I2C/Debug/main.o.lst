 108:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** #define XMC_GPIO_CHECK_OUTPUT_LEVEL(level) ((level == XMC_GPIO_OUTPUT_LEVEL_LOW) || \
 109:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****                                             (level == XMC_GPIO_OUTPUT_LEVEL_HIGH))
 110:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** 
 111:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** #define XMC_GPIO_CHECK_HWCTRL(hwctrl) ((hwctrl == XMC_GPIO_HWCTRL_DISABLED) || \
 112:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****                                        (hwctrl == XMC_GPIO_HWCTRL_PERIPHERAL1) || \
 113:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****                                        (hwctrl == XMC_GPIO_HWCTRL_PERIPHERAL2))
 114:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** 
