 589:D:/GITHUB/XMC14/I2C/Dave/Generated/I2C_MASTER\i2c_master.h ****  *  {
 590:D:/GITHUB/XMC14/I2C/Dave/Generated/I2C_MASTER\i2c_master.h ****  *   uint8_t rx_buf[25];
 591:D:/GITHUB/XMC14/I2C/Dave/Generated/I2C_MASTER\i2c_master.h ****  *   uint8_t tx_buf[2];
 592:D:/GITHUB/XMC14/I2C/Dave/Generated/I2C_MASTER\i2c_master.h ****  *   DAVE_STATUS_t init_status;
 593:D:/GITHUB/XMC14/I2C/Dave/Generated/I2C_MASTER\i2c_master.h ****  *   init_status = DAVE_Init();
