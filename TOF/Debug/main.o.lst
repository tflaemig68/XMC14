 168:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC1
 169:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * Initializes input / output mode settings like, pull up / pull down devices,hysteresis, push pull
 170:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * Also configures alternate function outputs and clears hardware port control for a selected \a po
 171:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * \a config provides selected I/O settings. It configures hardware registers Pn_IOCR,Pn_OUT, Pn_OM
 172:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * \endif
 173:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC4
 174:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * Initializes input / output mode settings like, pull up / pull down devices,push pull /open drain
 175:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * Also configures alternate function outputs and clears hardware port control for selected \a port
 176:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * It configures hardware registers Pn_IOCR,Pn_OUT,Pn_OMR,Pn_PDISC and Pn_PDR.\n
 177:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_gpio.h ****  * \endif
