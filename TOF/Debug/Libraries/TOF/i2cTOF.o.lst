1755:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1756:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1757:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
1758:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param data Data to be transmitted. \n
1759:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *           \b Range: 16bit unsigned data. minimum= 0, maximum= 65535
1760:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param loc Input location. \n
1761:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @return None
1762:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1763:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
1764:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Transmit data can be loaded to TBUF by software by writing to the transmit buffer input
1765:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * locations TBUFx (x = 00-31), consisting of 32 consecutive addresses. The data written
1766:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * to one of these input locations is stored in the transmit buffer TBUF. Additionally, the
1767:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * address of the written location is evaluated and can be used for additional control
1768:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * purposes. This 5-bit wide information (named Transmit Control Information TCI) can be
1769:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * used for different purposes in different protocols.
1770:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1771:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
1772:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_EnableWordLengthControl() \n
1773:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_EnableFrameLengthControl() \n\n\n
1774:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
1775:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** __STATIC_INLINE void XMC_USIC_CH_TXFIFO_PutDataEx(XMC_USIC_CH_t *const channel, const uint16_t data
1776:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** {
1777:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****   channel->IN[loc] = data;
1778:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** }
1779:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
1780:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1781:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1782:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
1783:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param data Data to be transmitted.
1784:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param frame_length Frame length to be configured while transmitting the data. \n
1785:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 			\b Range: minimum= 0, maximum= 31. e.g: For a frame length of 16, set \a frame_length as 15.
1786:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @return None
