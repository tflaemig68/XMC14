//OLED display text position
//[0]0 1 2 3 ... 127 (0~7)
//[1]0 1 2 3 ... 127 (8~15)
//[2]0 1 2 3 ... 127 (16~23)
//[3]0 1 2 3 ... 127 (24~31)


/*******************************************************************************
function:
			Write register address and data
*******************************************************************************/
void OLED_WriteDataS(uint8_t *Data, unsigned length)
{
	uint8_t cData =IIC_RAM;
	I2C_MASTER_Transmit(&I2C_MASTER_0,true,OLED_8Bit_ADDR,&cData,1,false);
	while(I2C_MASTER_IsTxBusy(&I2C_MASTER_0));
	I2C_MASTER_Transmit(&I2C_MASTER_0,false,OLED_8Bit_ADDR,Data,length,true);
	while(I2C_MASTER_IsTxBusy(&I2C_MASTER_0));
}

/* only one DataByte */
void OLED_WriteData(uint8_t Data)
{

	OLED_WriteDataS(&Data, 1);
	//OLED_Write_Byte(Data,IIC_RAM);
}


void OLED_WriteCmdS(uint8_t *Data, unsigned length)
{
	uint8_t cCmd =IIC_CMD;
	I2C_MASTER_Transmit(&I2C_MASTER_0,true,OLED_8Bit_ADDR,&cCmd,1,false);
	while(I2C_MASTER_IsTxBusy(&I2C_MASTER_0));
	I2C_MASTER_Transmit(&I2C_MASTER_0,false,OLED_8Bit_ADDR,Data,length,true);
	while(I2C_MASTER_IsTxBusy(&I2C_MASTER_0));
}
/* only one Cmd Byte */
void OLED_WriteCmd(uint8_t Cmd)
{
	OLED_WriteCmdS(&Cmd, 1);
    //OLED_Write_Byte(Reg,IIC_CMD);
}

/*******************************************************************
 * @name       :void OLED_WR_Byte(unsigned dat,unsigned cmd)
 * @date       :2018-08-27
 * @function   :Write a byte of content to the OLED screen
 * @parameters :dat:Content to be written
                cmd:0-write command
								    1-write data
 * @retvalue   :None
 * @comments : shloud by replaced by 		OLED_WriteCmdS() and OLED_WriteDataS
********************************************************************/
void OLED_WR_Byte(unsigned dat, unsigned cmd_data)
{
	switch(cmd_data)
	{
		case OLED_DATA:
		{
			//Write_IIC_Data(dat);
			OLED_WriteData(dat);
			break;
		}
		case OLED_CMD:
		{
			//Write_IIC_Command(dat);
			OLED_WriteCmd(dat);
			break;
		}
		default:
			break;
	}
}


/*******************************************************************
 * @name       :void OLED_Set_Pos(unsigned char x, unsigned char y) 
 * @date       :2018-08-27
 * @function   :Set coordinates in the OLED screen
 * @parameters :x:x coordinates
                y:y coordinates
 * @retvalue   :None
********************************************************************/
void OLED_Set_Pos(unsigned char x, unsigned char y) 
{
	const unsigned length = 3;
	unsigned DATA[3] = {YLevel+y, ((x&0xf0)>>4)|0x10, (x&0x0f)};
	OLED_WriteCmdS(Data, length);

