1686:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1687:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1688:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
1689:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param event Events to be disabled. @ref XMC_USIC_CH_TXFIFO_EVENT_CONF_t \n
1690:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @return None
1691:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1692:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
1693:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Disables the interrupt events related to transmit FIFO. \n\n
1694:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * By disabling the interrupt events, generation of interrupt is stopped. User can poll the event
1695:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * flags from the status register using the API XMC_USIC_CH_TXFIFO_GetEvent().
1696:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Event bitmasks can be constructed using the enumeration @ref XMC_USIC_CH_TXFIFO_EVENT_CONF_t. Fo
1697:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * multiple events, combine the events using bitwise OR operation.
1698:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1699:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
1700:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_TXFIFO_GetEvent(), XMC_USIC_CH_TXFIFO_EnableEvent() \n\n\n
1701:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
1702:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** __STATIC_INLINE void XMC_USIC_CH_TXFIFO_DisableEvent(XMC_USIC_CH_t *const channel, const uint32_t e
1703:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** {
1704:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****   channel->TBCTR &= (uint32_t)~event;
1705:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** }
1706:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
1707:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1708:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1709:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				      \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device
1710:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param interrupt_node Node pointer representing the transmit FIFO events. \n
1711:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 						  \b Range: @ref XMC_USIC_CH_TXFIFO_INTERRUPT_NODE_POINTER_STANDARD,
1712:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 						  			@ref XMC_USIC_CH_TXFIFO_INTERRUPT_NODE_POINTER_ALTERNATE
1713:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param service_request The service request to be used for interrupt generation. \n
1714:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 						  \b Range: 0 to 5.
1715:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @return None
1716:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1717:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
1718:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Sets an interrupt node for the transmit FIFO events.\n\n
1719:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * A node pointer represents one or more interrupt events. Service request represents the interrupt
1720:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * among the 6 interrupt nodes available for USIC module.
1721:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * API configures the service request to be used for interrupt generation for the events selected.
1722:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * A transmit FIFO event can generate an interrupt only if the interrupt node is configured for the
1723:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * the interrupt generation is enabled for the event. For example, transmit FIFO standard transmit 
1724:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * interrupt is generated if the interrupt node for the same is set and interrupt is enabled.<br>
1725:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1726:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Note: NVIC node should be explicitly enabled for the interrupt generation.
1727:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1728:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
1729:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_TXFIFO_EnableEvent() \n\n\n
1730:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
1731:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** void XMC_USIC_CH_TXFIFO_SetInterruptNodePointer(XMC_USIC_CH_t *const channel,
1732:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****     const XMC_USIC_CH_TXFIFO_INTERRUPT_NODE_POINTER_t interrupt_node,
1733:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****     const uint32_t service_request);
1734:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
1735:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1736:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1737:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
1738:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param data Data to be transmitted. \n
