   1:../Libraries/TOF/i2cTOF.c **** /**
   2:../Libraries/TOF/i2cTOF.c ****  * @file i2cTOF.c
   3:../Libraries/TOF/i2cTOF.c ****  * @brief VL53L0X-Entfernungssensor: Implementierung fuer DAVE 4.
   4:../Libraries/TOF/i2cTOF.c ****  * @author Linus Blanke, Christoph Lederbogen, Andreas Ladner, Philipp Roehlke
   5:../Libraries/TOF/i2cTOF.c ****  * @author tflaemig68 (Erweiterungen der Vorlage)
   6:../Libraries/TOF/i2cTOF.c ****  *
   7:../Libraries/TOF/i2cTOF.c ****  * @details Ein TOF-Sensor ermittelt die Entfernung ueber die Laufzeit von Licht.
   8:../Libraries/TOF/i2cTOF.c ****  * Die .h-Datei beschreibt die aufrufbaren Funktionen; die .c-Datei enthaelt
   9:../Libraries/TOF/i2cTOF.c ****  * deren Anweisungen. I2C uebertraegt Registeradressen und Daten zwischen
  10:../Libraries/TOF/i2cTOF.c ****  * Mikrocontroller (Master) und Sensor (Slave). Ein Register ist ein kleiner
  11:../Libraries/TOF/i2cTOF.c ****  * Speicherplatz im Sensor, der einen Messwert oder eine Einstellung enthaelt.
  12:../Libraries/TOF/i2cTOF.c ****  *
  13:../Libraries/TOF/i2cTOF.c ****  * @par Voraussetzungen
  14:../Libraries/TOF/i2cTOF.c ****  * DAVE_Init() und der Millisekundentimer muessen laufen. Sensorzeiger und
  15:../Libraries/TOF/i2cTOF.c ****  * Ausgabepuffer muessen gueltig sein. Buszugriffe nur aus dem Hauptprogramm;
  16:../Libraries/TOF/i2cTOF.c ****  * die Bibliothek verwendet gemeinsame interne Zustandsvariablen und ist
  17:../Libraries/TOF/i2cTOF.c ****  * nicht fuer gleichzeitige Aufrufe mehrerer Sensoren ausgelegt.
  18:../Libraries/TOF/i2cTOF.c ****  *
  19:../Libraries/TOF/i2cTOF.c ****  * @see https://www.st.com/en/embedded-software/stsw-img005.html
  20:../Libraries/TOF/i2cTOF.c ****  */
  21:../Libraries/TOF/i2cTOF.c **** // standard includes
  22:../Libraries/TOF/i2cTOF.c **** //#include <stdbool.h>
  23:../Libraries/TOF/i2cTOF.c **** //#include <stdlib.h>
  24:../Libraries/TOF/i2cTOF.c **** 
  25:../Libraries/TOF/i2cTOF.c **** // includes from mcal and cmsis
  26:../Libraries/TOF/i2cTOF.c **** //#include <stm32f4xx.h>
  27:../Libraries/TOF/i2cTOF.c **** //#include <mcalI2C.h>
  28:../Libraries/TOF/i2cTOF.c **** 
  29:../Libraries/TOF/i2cTOF.c **** // inits from Balancer library
  30:../Libraries/TOF/i2cTOF.c **** #include "i2cTOF.h"
  31:../Libraries/TOF/i2cTOF.c **** #include "tof_dave_port.inc"
  32:../Libraries/TOF/i2cTOF.c **** //#include <ST7735.h>
  33:../Libraries/TOF/i2cTOF.c **** 
  34:../Libraries/TOF/i2cTOF.c **** 
  35:../Libraries/TOF/i2cTOF.c **** // Variables for I2C and TOF sensor address
  36:../Libraries/TOF/i2cTOF.c **** /** @brief Adresse des zuletzt fuer einen Zugriff ausgewaehlten Sensors. */
  37:../Libraries/TOF/i2cTOF.c **** TOF_ADDR_t TOF_address_used = TOF_ADDR_NONE; // TOF sensor address, initially set to NONE (-1)
  38:../Libraries/TOF/i2cTOF.c **** /** @brief Gemeinsamer Buszeiger; parallele Bibliotheksaufrufe sind nicht vorgesehen. */
  39:../Libraries/TOF/i2cTOF.c **** I2C_MASTER_t *TOF_i2c;  // Zeiger auf die DAVE-I2C-APP, normalerweise &I2C_MASTER_0
  40:../Libraries/TOF/i2cTOF.c **** 
  41:../Libraries/TOF/i2cTOF.c **** // TOF stop variable for register store value (used to store certain register values temporarily)
  42:../Libraries/TOF/i2cTOF.c **** /** @brief Vom Sensor gelesener interner Wert fuer spaetere Startsequenzen. */
  43:../Libraries/TOF/i2cTOF.c **** static uint8_t TOF_stop_variable = 0;
  44:../Libraries/TOF/i2cTOF.c **** 
  45:../Libraries/TOF/i2cTOF.c **** // Flag for continuous mode (Indicates if the sensor is in continuous measurement mode)
  46:../Libraries/TOF/i2cTOF.c **** /** @brief Merkt sich den Dauerbetrieb fuer den einzigen verwendeten Sensor. */
  47:../Libraries/TOF/i2cTOF.c **** bool TOF_continuous_mode = false;
  48:../Libraries/TOF/i2cTOF.c **** 
  49:../Libraries/TOF/i2cTOF.c **** // Math macros for sensor configuration and period decoding
  50:../Libraries/TOF/i2cTOF.c **** 
  51:../Libraries/TOF/i2cTOF.c **** // Calculate macro period based on VCSEL period (pulses per clock)
