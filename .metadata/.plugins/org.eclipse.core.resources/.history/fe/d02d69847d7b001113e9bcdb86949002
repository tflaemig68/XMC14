/********************************************************************************
  function: Delay function
  note:
  Driver_Delay_ms(xms) : Delay x ms
 *******************************************************************************/
void Driver_Delay_ms(uint16_t xms)
{
	extern volatile uint32_t SysTickCounter
	uint32_t start= SysTickCounter;
	while((SysTickCounter - start) < (uint32_t)(xms))
	{
		__NOP();
	}
}


static I2C_MASTER_STATUS_t SSD1306_Send(    uint8_t *buffer,    uint32_t length)
{
    return I2C_MASTER_Transmit(
                &I2C_MASTER_0,
                true,
				SSD1306_SLAVE_ADDR_WR,
                buffer,
                length,
                true);
}


static void SSD1306_WriteCommand(uint8_t cmd)
{
    uint8_t data[2];

    data[0] = 0x00;
    data[1] = cmd;


    SSD1306_Send(data, 2);

}

static void SSD1306_WriteData(uint8_t *data,uint16_t size)
{
    uint8_t tx[17];

    tx[0] = 0x40;

    while(size)
    {
        uint8_t chunk = (size > 16) ? 16 : size;

        memcpy(&tx[1], data, chunk);
        SSD1306_Send(tx, chunk + 1);

        data += chunk;
        size -= chunk;
    }
}

