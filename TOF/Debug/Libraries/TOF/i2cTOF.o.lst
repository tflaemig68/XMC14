   1:../Libraries/TOF/tof_dave_port.inc **** /**
   2:../Libraries/TOF/tof_dave_port.inc ****  * @file tof_dave_port.inc
   3:../Libraries/TOF/tof_dave_port.inc ****  * @brief Uebersetzt TOF-Registerzugriffe in DAVE-I2C-Befehle.
   4:../Libraries/TOF/tof_dave_port.inc ****  *
   5:../Libraries/TOF/tof_dave_port.inc ****  * @details Diese Datei wird in i2cTOF.c eingebunden, nicht separat kompiliert.
   6:../Libraries/TOF/tof_dave_port.inc ****  * static beschraenkt die Hilfsfunktionen auf diese Uebersetzungseinheit.
   7:../Libraries/TOF/tof_dave_port.inc ****  * Das I2C_MASTER_t-Handle enthaelt unter anderem den Hardwarekanal und
   8:../Libraries/TOF/tof_dave_port.inc ****  * Laufzeitinformationen. Die Portierung setzt DIRECT-Betrieb mit FIFO voraus.
   9:../Libraries/TOF/tof_dave_port.inc ****  * Ein FIFO ist ein Puffer: Das zuerst abgelegte Byte wird zuerst entnommen.
  10:../Libraries/TOF/tof_dave_port.inc ****  *
  11:../Libraries/TOF/tof_dave_port.inc ****  * I2C-Wartephasen haben 20 ms Zeitlimit, Sensorbereitschaft 1000 ms.
  12:../Libraries/TOF/tof_dave_port.inc ****  *
  13:../Libraries/TOF/tof_dave_port.inc ****  * @pre DAVE und der Millisekundentimer laufen; Aufruf nur aus dem Hauptprogramm.
  14:../Libraries/TOF/tof_dave_port.inc ****  * @note Die vorhandenen DAVE-Bytefunktionen werden mit begrenztem Warten
  15:../Libraries/TOF/tof_dave_port.inc ****  * kombiniert. Ein Sensor verwendet die 7-Bit-Adresse 0x29; auf dem Bus
  16:../Libraries/TOF/tof_dave_port.inc ****  * reserviert DAVE zusaetzlich das niederwertigste Bit fuer Lesen/Schreiben.
  17:../Libraries/TOF/tof_dave_port.inc ****  */
  18:../Libraries/TOF/tof_dave_port.inc **** 
  19:../Libraries/TOF/tof_dave_port.inc **** extern volatile uint32_t SysTickCounter;
  20:../Libraries/TOF/tof_dave_port.inc **** /** @brief Rueckgabecode: 0 bedeutet Erfolg, 1 bedeutet Fehler. */
  21:../Libraries/TOF/tof_dave_port.inc **** typedef enum { I2C_OK = 0, I2C_ERROR = 1 } I2C_RETURN_CODE_t;
  22:../Libraries/TOF/tof_dave_port.inc **** /* Maximale Wartezeit einer I2C-Phase in Millisekunden. */
  23:../Libraries/TOF/tof_dave_port.inc **** #define TOF_I2C_TIMEOUT_MS 20U
  24:../Libraries/TOF/tof_dave_port.inc **** /* Maximale Wartezeit auf Sensorbereitschaft in Millisekunden. */
  25:../Libraries/TOF/tof_dave_port.inc **** #define TOF_SENSOR_TIMEOUT_MS 1000U
  26:../Libraries/TOF/tof_dave_port.inc **** /* Bitmaske der als Fehler gewerteten I2C-Hardwaremeldungen. */
  27:../Libraries/TOF/tof_dave_port.inc **** #define TOF_I2C_ERRORS (XMC_I2C_CH_STATUS_FLAG_NACK_RECEIVED | \
  28:../Libraries/TOF/tof_dave_port.inc ****                         XMC_I2C_CH_STATUS_FLAG_ARBITRATION_LOST | \
