   1:../main.c     **** /**
   2:../main.c     ****  * @file main.c
   3:../main.c     ****  * @brief Einstieg in den TOF-Distanztest mit DAVE 4 und OLED.
   4:../main.c     ****  *
   5:../main.c     ****  * @details Nach dem Einschalten richtet main() die Hardware ein und startet
   6:../main.c     ****  * den VL53L0X. In einer Endlosschleife werden Messung, Anzeige, LED und PWM
   7:../main.c     ****  * zu unterschiedlichen Zeitpunkten bearbeitet. Ein Timer zaehlt dazu die
   8:../main.c     ****  * vergangenen Millisekunden. Die Vorlage stammt aus TOFTest/Src/main.c
   9:../main.c     ****  * des STM32-Cube-Projekts; hier werden DAVE-APPs verwendet.
  10:../main.c     ****  *
  11:../main.c     ****  * @par Lesereihenfolge fuer Einsteiger
  12:../main.c     ****  * Zuerst main() und TOFSensor_t lesen, dann TOF_init() und
  13:../main.c     ****  * TOF_read_continuous_distance(). Die Einzelheiten des I2C-Protokolls
  14:../main.c     ****  * stehen in tof_dave_port.inc.
  15:../main.c     ****  *
  16:../main.c     ****  * @note Der Timer muss auch bei I2C-Zugriffen weiterlaufen, damit Zeitlimits
  17:../main.c     ****  * erkannt werden. Deshalb findet im Timer-Callback keine Buskommunikation statt.
  18:../main.c     ****  */
  19:../main.c     **** #include "DAVE.h"
  20:../main.c     **** #include "Libraries/TOF/i2cTOF.h"
  21:../main.c     **** #include "Libraries/OLED/oled.h"
  22:../main.c     **** #include "Libraries/OLED/gui.h"
  23:../main.c     **** #include "Libraries/OLED/test.h"
  24:../main.c     **** #include <stdio.h>
  25:../main.c     **** 
  26:../main.c     **** /** @brief Port/Pin-Paar der LED fuer das Lebenszeichen (P0.7). */
  27:../main.c     **** #define LED1 XMC_GPIO_PORT0, 7
  28:../main.c     **** /** @brief Port/Pin-Paar der Fehler-LED (P0.6). */
  29:../main.c     **** #define LED2 XMC_GPIO_PORT0, 6
  30:../main.c     **** /** @brief Standardprofil mit 30 ms Messbudget. */
  31:../main.c     **** #define TOF_PROFILE TOF_DEFAULT_MODE_D
  32:../main.c     **** 
  33:../main.c     **** /**
  34:../main.c     ****  * @brief Seit Timerstart vergangene Millisekunden.
  35:../main.c     ****  * @details volatile zeigt dem Compiler, dass ein Interrupt den Wert aendern
  36:../main.c     ****  * kann. Es ersetzt keine Sperre fuer komplexe gemeinsame Datenzugriffe.
  37:../main.c     ****  */
  38:../main.c     **** volatile uint32_t SysTickCounter = 0U;
  39:../main.c     **** /** @brief Bus, Einstellungen und letzter Messwert des einzigen Sensors. */
  40:../main.c     **** TOFSensor_t TOF_Sensor_1;
  41:../main.c     **** /** @brief true, solange Initialisierung und Messbetrieb erfolgreich sind. */
  42:../main.c     **** volatile bool initedTOF = false;
  43:../main.c     **** /** @brief Anzahl erkannter TOF-Fehler; im Debugger beobachtbar. */
  44:../main.c     **** volatile uint32_t tof_error_count = 0U;
