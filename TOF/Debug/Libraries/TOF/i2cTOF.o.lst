2110:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
2111:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** __STATIC_INLINE uint16_t XMC_USIC_CH_RXFIFO_GetData(XMC_USIC_CH_t *const channel)
2112:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** {
2113:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****   return (uint16_t)(channel->OUTR);
2114:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** }
2115:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
2116:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
