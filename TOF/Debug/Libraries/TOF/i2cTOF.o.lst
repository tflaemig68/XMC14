1751:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** {
1752:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****   channel->IN[0] = data;
