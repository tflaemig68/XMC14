2067:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
2068:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
2069:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
2070:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param interrupt_node Node pointer representing the receive FIFO events. \n
2071:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 					\b Range: @ref XMC_USIC_CH_RXFIFO_INTERRUPT_NODE_POINTER_STANDARD,
2072:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 					@ref XMC_USIC_CH_RXFIFO_INTERRUPT_NODE_POINTER_ALTERNATE
2073:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param service_request The service request to be used for interrupt generation.\n
2074:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 					\b Range: 0 to 5.
2075:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @return None
2076:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
2077:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
2078:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Sets an interrupt node for the receive FIFO events. \n\n
2079:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * A node pointer represents one or more interrupt events. Service request represents the interrupt
2080:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * among the 6 interrupt nodes available for USIC module.
2081:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * API configures the service request to be used for interrupt generation for the events selected.
2082:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * A receive FIFO event can generate an interrupt only if the interrupt node is configured for the 
2083:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * the interrupt generation is enabled for the event. For example, transmit FIFO standard transmit 
2084:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * interrupt is generated if the interrupt node for the same is set and interrupt is enabled.<br>
2085:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
2086:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Note: NVIC node should be explicitly enabled for the interrupt generation.
2087:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
2088:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
2089:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_RXFIFO_EnableEvent() \n\n\n
2090:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
