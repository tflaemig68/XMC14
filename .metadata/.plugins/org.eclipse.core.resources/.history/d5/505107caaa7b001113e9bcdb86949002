 * code.
 */
int main(void)
{
  DAVE_STATUS_t status;
  uint32_t TimerId;
  uint32_t update_5SecTimer;
  uint32_t run_status = 0;
  char str[]= "DHBW Stuttgart";
  char str_time[16] = "000";


  status = DAVE_Init();           /* Initialization of DAVE APPs  */
  LED_init();

  //XMC_GPIO_SetMode(P2_11, XMC_GPIO_MODE_INPUT_PULL_UP);

  DAVE_APP_VERSION_t version = I2C_MASTER_GetAppVersion();
  if(version.major == 4U)
  {
	 //I2C_MASTER_0_init();
	 //I2C_MASTER_Transmit(&I2C_MASTER_0,true,0x78,mem_address,1,true);
  }

  // SYSTIMER APP Initialized during DAVE Initialization
  // Create Software timer
  TimerId = (uint32_t)SYSTIMER_CreateTimer(milliSec,SYSTIMER_MODE_PERIODIC,(void*)milliSec_Handler,NULL);
  if (TimerId != 0U)
  {
	//software timer is created successfully
	//Add user code here
	SYSTIMER_StartTimer(TimerId);
  }
  else
  {
	// //software timer creation is failed
  }

  if (status != DAVE_STATUS_SUCCESS)
  {
    /* Placeholder for error handler code. The while loop below can be replaced with an user error handler. */
    XMC_DEBUG("DAVE APPs initialization failed\n");

    while(1U)
    {

    }
  }
  delay_ms(500);
  OLED_Init();
  OLED_Clear(0);
  //TEST_MainPage();


  /* Placeholder for user application code. The while loop below can be replaced with user application code. */
  while(1U)
  {

	  if (run1sec > 0)
	  {
		  sprintf(str_time,"%6u", (unsigned int)(SysTickCounter/1000));
		  GUI_ShowString((u8)40,(u8)4,(u8*)str_time,(u8)8,(u8)1);
		  run1sec -=1;
	  }


	  if((SysTickCounter - update_5SecTimer) >= 5000)
	  {
		  update_5SecTimer = SysTickCounter;
		  switch (run_status++)
		  {
			  case 0:
			  GUI_ShowString((u8)0,(u8)0,(u8*)str,(u8)16,(u8)1);

			  //TEST_MainPage();
			  break;
			  case 1:
			  Test_Color();
			  break;
			  case 2:
			  TEST_English();
			  break;
			  case 3:
			  TEST_Number_Character();
			  break;
			  case 4:
			  TEST_Chinese();
			  break;
			  case 5:
			  TEST_BMP();
			  break;

			  default:
			  {
			  run_status = 0;
			  OLED_Clear(1);
			  }
			  break;
		  }

	  }

  }
}
