 160:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h **** /**
 161:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * @param  port	  Constant pointer pointing to GPIO port, to access port registers like Pn_OUT,Pn_O
 162:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * @param  pin	  Port pin number.
 163:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * @param  config GPIO configuration data structure. Refer data structure @ref XMC_GPIO_CONFIG_t fo
 164:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
 165:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * @return None
 166:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  *
 167:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \par<b>Description:</b><br>
 168:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC1
 169:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Initializes input / output mode settings like, pull up / pull down devices,hysteresis, push pull
 170:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Also configures alternate function outputs and clears hardware port control for a selected \a po
 171:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \a config provides selected I/O settings. It configures hardware registers Pn_IOCR,Pn_OUT, Pn_OM
 172:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \endif
 173:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC4
 174:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Initializes input / output mode settings like, pull up / pull down devices,push pull /open drain
 175:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * Also configures alternate function outputs and clears hardware port control for selected \a port
 176:D:/GITHUB/XMC14/I2C/Libraries/XMCLib/inc\xmc_gpio.h ****  * It configures hardware registers Pn_IOCR,Pn_OUT,Pn_OMR,Pn_PDISC and Pn_PDR.\n
