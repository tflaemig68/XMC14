1590:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1591:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1592:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
1593:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param data_pointer Start position inside the FIFO buffer. \n
1594:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 		\b Range: 0 to 63.
1595:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param size Required size of the transmit FIFO. \n
1596:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 		\b Range: @ref XMC_USIC_CH_FIFO_DISABLED, @ref XMC_USIC_CH_FIFO_SIZE_2WORDS.. @ref XMC_USIC_CH
1597:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param limit Threshold of transmit FIFO filling level to be considered for generating events. \n
1598:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 		\b Range: 0 to \a size -1.
1599:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @return None
1600:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1601:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
1602:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Initializes the transmit FIFO. \n\n
1603:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Transmit FIFO is a subset of a common FIFO sized 64 words. This FIFO is shared between 2 channel
1604:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * Each channel can share the FIFO for transmission and reception. \a data_pointer represents the s
1605:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * from where transmit data can be put, for the selected USIC channel. \a size represents the size 
1606:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 2. Since the FIFO is shared between 2 USIC channels, FIFO size should be carefully selected. A F
1607:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * event is generated when the FIFO filling level falls below the \a limit value.
1608:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  *
1609:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
1610:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_TXFIFO_EnableEvent(), XMC_USIC_CH_TXFIFO_SetInterruptNodePointer() \n\n\n
1611:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  */
1612:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** void XMC_USIC_CH_TXFIFO_Configure(XMC_USIC_CH_t *const channel,
1613:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****                                   const uint32_t data_pointer,
1614:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****                                   const XMC_USIC_CH_FIFO_SIZE_t size,
1615:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****                                   const uint32_t limit);
1616:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** 
1617:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h **** /**
1618:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param channel Pointer to USIC channel handler of type @ref XMC_USIC_CH_t \n
1619:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * 				   \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device su
1620:D:/GITHUB/XMC14/TOF/Libraries/XMCLib/inc\xmc_usic.h ****  * @param size Required size of the transmit FIFO. \n
