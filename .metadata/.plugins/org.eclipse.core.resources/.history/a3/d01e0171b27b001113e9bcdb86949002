/*****************************************************************************
 * @name       :void Test_Color(void)
 * @date       :2018-08-27 
 * @function   :Color fill test(white,black)
 * @parameters :None
 * @retvalue   :None
******************************************************************************/
void Test_Color(uint16_t mode)
{
	 static uint16_t imode = 0;
	 if (mode > 0) imode = mode;
	 switch (++imode)
	 {
	 	 case 1:
	     {
		 GUI_Fill(0,0,WIDTH-1,7,0);
		 GUI_ShowString(10,1,"BLACK",16,1);
	     }
	     break;
	 	 case 2:
	 	 {
			 GUI_Fill(0,0,WIDTH-1,7,1);
			 GUI_ShowString(10,1,"WHITE",16,0);
	 	 }
	 	 break;
	 	 default:
	 		 imode = 0;
	 		 break;

	 }
}

